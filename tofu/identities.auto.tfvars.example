# tofu/identities.auto.tfvars: the guests' MACs and SMBIOS UUIDs (variables.tf,
# guest_identities). Copy this to identities.auto.tfvars on phoenix and replace
# every value with the guest's own, from `qm config <vmid>` on Saruman or from
# the escrow, TOFU_GUEST_IDENTITIES in secrets/tofu.sops.yaml. That file is
# gitignored, and check-tracked-artefacts.sh fails a tracked one: the values are
# on docs/security.md's do-not-publish list. These placeholders only show the
# shape: a MAC in Proxmox's BC:24:11 prefix, upper case, and a UUID for the six
# domain guests and no one else.

guest_identities = {
  bahamut      = { mac_address = "BC:24:11:00:00:96", smbios_uuid = "00000000-0000-0000-0000-000000000150" }
  leviathan    = { mac_address = "BC:24:11:00:00:97", smbios_uuid = "00000000-0000-0000-0000-000000000151" }
