  carbuncle    = { mac_address = "BC:24:11:00:00:9A", smbios_uuid = "00000000-0000-0000-0000-000000000154" }
  siren        = { mac_address = "BC:24:11:00:00:9B", smbios_uuid = "00000000-0000-0000-0000-000000000155" }
  dot-debian   = { mac_address = "BC:24:11:00:00:BF" }
  dot-fedora   = { mac_address = "BC:24:11:00:00:C0" }
