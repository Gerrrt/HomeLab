# The snmp_exporter config is machine-generated from snmp-exporter/generator.yaml.
# Marking it as generated keeps 14k lines of OID definitions out of GitHub's
# language stats and collapses it by default in diffs.
stacks/observability/snmp-exporter/snmp.yaml linguist-generated=true -diff

# Grafana dashboard JSON is exported by Grafana, not hand-maintained line by line.
stacks/observability/grafana/dashboards/*.json linguist-generated=true

# FoxIO's ja4-zeek-scripts, vendored byte-for-byte by scripts/vendor-ja4.sh
# (ADR-0069). Upstream's trailing spaces stay, so `git diff --check` is told
# they are not ours to flag; linguist-vendored keeps it out of language stats.
stacks/sensor/zeek/ja4/** -whitespace linguist-vendored

# Normalise line endings.
* text=auto eol=lf
*.png binary

# sysmon-modular's Sysmon config, vendored byte-for-byte by
# scripts/vendor-sysmon-config.sh (ADR-0080). -text, not just -whitespace: it
# has CRs, and the eol=lf above would rewrite them, which changes the sha256
# that ansible/verify.yml compares with each guest's Sysmon ConfigHash. It sits
# below the catch-all because, of two lines that match, the later one wins.
ansible/roles/sysmon/files/sysmonconfig.xml -text -whitespace linguist-vendored
