# Non-sensitive tunables for the observability stack.
#
# Edit this file, not .env — scripts/render-config.sh regenerates .env from it
# on every `make up`. Or rely on the defaults baked into compose.yaml.
# Secrets do NOT belong here — see secrets/README.md.
#
# scripts/render-config.sh appends the decrypted secret values to .env at
# deploy time, which is why .env itself is gitignored.

# Address the published ports bind to. 0.0.0.0 exposes them to every VLAN the
# host can reach; set this to the management IP to restrict them to VLAN 99.
#
# Change it *here*, not in .env: scripts/render-config.sh rewrites .env from
# this file on every `make up`, so an edit to .env lasts until the next deploy
# and no longer. The committed value is the deployed value.
#
# Alertmanager is not governed by this — it is pinned to 127.0.0.1 in
# compose.yaml, being the one service with no off-host client (#70).
BIND_ADDR=0.0.0.0

# Used for Alertmanager's external URL in notification links. Since 9093 binds
# to loopback (#70) that link only opens on this host; off-host, silences are in
# Grafana under Alerting.
MONITORING_HOST=10.0.99.20

# Host ports. ALERTMANAGER and ALLOY are published on 127.0.0.1; the rest on
# BIND_ADDR. See the note above.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
GRAFANA_PORT=3000
ALLOY_PORT=12345
# Network syslog receiver (UDP). Point pfSense at <this host>:1514.
# This is the host side only; the container always listens on 1514. A device
# that can only send to the standard port is handled by SYSLOG_PORT=514 —
# dockerd binds it as root, so the container needs no privilege. See the
# comment on this mapping in compose.yaml.
SYSLOG_PORT=1514

# ALLOY_HOSTNAME is NOT set here. scripts/render-config.sh writes it from
# `hostname` at render time, because it differs per monitored host. Setting it
# here would pin every host to the same name.

# Metric retention. Loki's log retention is set separately in
# loki/loki-config.yaml (retention_period) — keep the two in step.
PROMETHEUS_RETENTION=30d

# A byte ceiling on the same store, so whichever limit is reached first wins.
# Sized from the per-block write rate, not from the store's current size: at
# 72.9 MiB/day, 30 days is 2.28 GiB, or 2.73 GiB once Saruman gets an agent
# (#88). 12 GiB is 4.4x that and 12% of the volume. It is meant never to bind —
# if it does, retention is quietly shorter than the line above claims, and
# PrometheusSizeRetentionActive is what says so. compose.yaml has the full
# derivation and the reason a smaller number would have been wrong. Loki has no
# size bound at all.
PROMETHEUS_RETENTION_SIZE=12GB
