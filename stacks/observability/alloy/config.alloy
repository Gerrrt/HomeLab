// =============================================================================
// Grafana Alloy — unified metrics and log collection agent.
//
// This same file runs on every monitored host. The two remote endpoints are
// read from the environment so a host outside the compose network can point at
// the monitoring host explicitly:
//
//   LOKI_URL=http://10.0.99.20:3100/loki/api/v1/push
//   PROMETHEUS_REMOTE_WRITE_URL=http://10.0.99.20:9090/api/v1/write
//
// Inside the observability stack the compose service names are the defaults.
// See docs/observability.md.
//
// ALLOY_HOSTNAME is the name this agent labels everything with, and it is read
// from the environment rather than taken from constants.hostname.
//
// constants.hostname is the CONTAINER's hostname, and the only way to give the
// container a real one is `hostname:` in compose — which also registers that
// name in Docker's embedded DNS. This host is called `prometheus`, so doing
// that published a second A record for the name `prometheus` pointing at the
// Alloy container. Every remote_write to http://prometheus:9090 then had a
// 50/50 chance of dialling Alloy itself, which refuses on 9090.
//
// Observed: host and container metrics stopped for twelve and a half hours
// while `up{job="alloy"}` stayed 1 the entire time, because Alloy's own
// /metrics endpoint was never the thing that was broken. Nothing alerted.
//
// The coalesce fallback to constants.hostname is kept so an agent started
// without the variable still labels itself with something, the way it always
// did — a container ID is wrong, but it is visibly wrong.
// =============================================================================

// ============================================================================
// METRICS COLLECTION
// ============================================================================

prometheus.exporter.cadvisor "dockermetrics" {
	docker_host      = "unix:///var/run/docker.sock"
	storage_duration = "5m"

	// Once the container can see the host's cgroups (compose sets cgroup: host,
	// see the comment there) cAdvisor reports every systemd slice on the machine
	// as well as the containers — 3365 series where 450 are Docker's. Every
	// dashboard and rule here filters on name!="", so the rest is retention spent
	// on nothing.
	docker_only = true
}

prometheus.scrape "dockermetrics" {
	targets         = discovery.relabel.dockermetrics.output
	forward_to      = [prometheus.remote_write.metrics_service.receiver]
	scrape_interval = "60s"
}

// Both exporters default `instance` to constants.hostname, which is the
// container ID now that the container no longer carries a hostname. Overwrite
// it from the environment for the same reason every other label here is set
// that way — see the header. Without this the dashboards' $instance variable
// lists a hex string that changes on every redeploy.
discovery.relabel "dockermetrics" {
	targets = prometheus.exporter.cadvisor.dockermetrics.targets

	rule {
		target_label = "instance"
		replacement  = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname)
	}
}

discovery.relabel "metrics" {
	targets = prometheus.exporter.unix.metrics.targets

	rule {
		target_label = "job"
		replacement  = string.format("%s-metrics", coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname))
	}

	rule {
		target_label = "instance"
		replacement  = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname)
	}
}

prometheus.exporter.unix "metrics" {
	disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]
	enable_collectors  = ["meminfo"]
	rootfs_path        = "/rootfs"

	// Where scripts/run-scheduled.sh records whether each scheduled maintenance
	// job actually ran (#77). Four gauges per job, read fresh on every scrape, so
	// `time() - homelab_job_last_success_timestamp_seconds` keeps climbing while
	// nothing is running it — which is the whole signal.
	//
	// The path is /rootfs-prefixed EVEN THOUGH rootfs_path is set above.
	// rootfs_path applies to the procfs/sysfs/filesystem collectors and not to
	// this argument, which is taken literally. Getting that wrong produces no
	// error at all: the collector reports an empty directory and every
	// homelab_job_* metric silently never exists.
	//
	// No compose change goes with this. compose.yaml already bind-mounts / at
	// /rootfs:ro for the node metrics, so the directory is already visible. It
	// must be 0755 with 0644 files, because this container is root with
	// cap_drop: [ALL] and therefore obeys the mode like anyone else — the same
	// measurement compose.yaml records against the age key.
	//
	// textfile is on by default, so enable_collectors needs no change. It brings
	// node_textfile_mtime_seconds and node_textfile_scrape_error along with it,
	// both of which the runbook uses for troubleshooting.
	textfile {
		directory = "/rootfs/var/lib/node_exporter/textfile_collector"
	}

	filesystem {
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
		mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
		mount_timeout        = "5s"
	}

	netclass {
		ignored_devices = "^(veth.*|cali.*|[a-f0-9]{15})$"
	}

	netdev {
		device_exclude = "^(veth.*|cali.*|[a-f0-9]{15})$"
	}
}

prometheus.scrape "metrics" {
	scrape_interval = "60s"
	targets         = discovery.relabel.metrics.output
	forward_to      = [prometheus.remote_write.metrics_service.receiver]
}

// Alloy scraping itself, so that every agent's own internals reach Prometheus.
//
// prometheus.yaml scrapes alloy:12345 over the compose network, which reaches
// exactly one agent: the one on the monitoring host. `oracle` publishes 12345
// on loopback only (ADR-0012), so there is no address Prometheus could be
// pointed at, and opening one is the wrong trade — #182 already tracks
// authenticating the ingest ports that are published. Scraping ourselves and
// pushing the result down the pipe that is already open costs nothing and
// generalises to every future agent without touching the monitoring host.
//
// This is what makes `prometheus_remote_storage_*` and `alloy_component_*`
// exist for an agent other than the local one. Without it the remote_write
// fault in #12 — samples failing to a stale address for hours — is invisible on
// every host except this one. That is the case #81 was filed on.
//
// THE LOCAL AGENT IS NOW COLLECTED TWICE, and that is deliberate rather than an
// oversight to tidy up. The direct scrape gives `up{job="alloy"}`, which goes
// to 0 when the agent dies. What arrives here by remote_write cannot: a dead
// agent stops pushing, so its `up` goes stale and disappears rather than
// falling, and `InstanceDown` is `up == 0`. Keeping both means the local agent
// has a liveness signal a rule can match, and every agent has the internals.
// The cost is ~600 duplicated series at 60s against a 16k head.
//
// The job label follows the `<hostname>-metrics` convention set above rather
// than a constant, so two agents never collide on one job name.
discovery.relabel "selfmetrics" {
	targets = [{__address__ = "127.0.0.1:12345"}]

	rule {
		target_label = "job"
		replacement  = string.format("%s-alloy", coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname))
	}

	rule {
		target_label = "instance"
		replacement  = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname)
	}
}

prometheus.scrape "selfmetrics" {
	scrape_interval = "60s"
	targets         = discovery.relabel.selfmetrics.output
	forward_to      = [prometheus.remote_write.metrics_service.receiver]
}

// ============================================================================
// DOCKER LOG COLLECTION
// ============================================================================

discovery.docker "dockerlogs" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "dockerlogs" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "service_name"
	}
}

loki.source.docker "default" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.dockerlogs.targets
	labels        = {"platform" = "docker", "log_type" = "docker"}
	relabel_rules = discovery.relabel.dockerlogs.rules
	forward_to    = [loki.process.dockerlogs_filter.receiver]
}

loki.process "dockerlogs_filter" {
	stage.drop {
		expression = "GET /metrics"
	}

	stage.drop {
		expression = "healthcheck"
	}

	stage.drop {
		expression = "container=(grafana|alloy)"
	}

	// Container stdout goes through log_processor rather than straight to the
	// writer, so it arrives carrying a `level` like every other source. It did
	// not before, and Loki drops empty labels, so every panel filtering on
	// level excluded containers entirely — 6429 lines an hour, the largest
	// single bucket in the estate, invisible on a dashboard whose level picker
	// said "All" (#83).
	//
	// log_processor forwards to loki.write.grafana_loki itself, so the
	// destination is unchanged; only the hop is new. Referring to a component
	// declared further down the file is fine — Alloy resolves the component
	// graph, not the file order.
	//
	// Two consequences, both accepted knowingly, and both behaviours varlogs
	// has had all along:
	//
	//   - A line with no severity word in it hits log_processor's
	//     `{{ else }}info{{ end }}` fallback and becomes `info`.
	//   - A line that says "error" incidentally — `error_rate=0`, a URL path —
	//     becomes level=error and shows up in "Errors and above".
	//
	// Cardinality goes from one stream per container to at most five. That is
	// nothing against what ADR-0003 is actually worried about.
	forward_to = [loki.process.log_processor.receiver]
}

// ============================================================================
// JOURNAL LOG COLLECTION
// ============================================================================

loki.source.journal "journal" {
	max_age       = "24h0m0s"
	relabel_rules = discovery.relabel.journal.rules
	forward_to    = [loki.write.grafana_loki.receiver]
	labels        = {
		component = "/var/log/journal",
		instance  = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname),
		hostname  = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname),
		job       = "/var/log/journal",
		log_type  = "journal",
	}
	path = "/var/log/journal"
}

discovery.relabel "journal" {
	targets = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal__boot_id"]
		target_label  = "boot_id"
	}

	rule {
		source_labels = ["__journal__transport"]
		target_label  = "transport"
	}

	// The same five-value mapping as loki.relabel.network_syslog below, against
	// journald's priority keyword instead of the syslog PRI. See that block for
	// why it is written this way; journald's vocabulary is emerg, alert, crit,
	// err, warning, notice, info and debug, all of which the alternations cover.
	rule {
		source_labels = ["__journal_priority_keyword"]
		regex         = ".+"
		target_label  = "level"
		replacement   = "info"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		regex         = "emergency|emerg|alert|critical|crit"
		target_label  = "level"
		replacement   = "critical"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		regex         = "error|err"
		target_label  = "level"
		replacement   = "error"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		regex         = "warning|warn"
		target_label  = "level"
		replacement   = "warning"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		regex         = "debug|dbug|dbg"
		target_label  = "level"
		replacement   = "debug"
	}
}

// ============================================================================
// AUTH LOG COLLECTION
// ============================================================================

local.file_match "authlogs" {
	path_targets = [
		{
			__address__ = "localhost",
			__path__    = "/var/log/auth.log",
			instance    = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname),
			job         = "/var/log/auth.log",
		},
	]
	sync_period = "60s"
}

loki.source.file "authlogs" {
	targets       = local.file_match.authlogs.targets
	forward_to    = [loki.process.authlogs.receiver]
	tail_from_end = true
}

loki.process "authlogs" {
	stage.static_labels {
		values = {
			log_type = "authlog",
			source   = "authlog",
		}
	}
	forward_to = [loki.process.log_processor.receiver]
}

// ============================================================================
// VAR LOG COLLECTION
// ============================================================================

local.file_match "varlogs" {
	path_targets = [
		{
			__address__      = "localhost",
			__path__         = "/var/log/{messages,*.log}",
			__path_exclude__ = "/var/log/(syslog|auth.log)",
			instance         = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname),
			job              = "/var/log/*.log",
		},
	]
	sync_period = "60s"
}

loki.source.file "varlogs" {
	targets       = local.file_match.varlogs.targets
	forward_to    = [loki.process.varlogs.receiver]
	tail_from_end = true
}

loki.process "varlogs" {
	stage.static_labels {
		values = {
			log_type = "varlog",
			source   = "varlog",
		}
	}
	forward_to = [loki.process.log_processor.receiver]
}

// ============================================================================
// SYSLOG COLLECTION
// ============================================================================

local.file_match "syslog" {
	path_targets = [
		{
			__address__ = "localhost",
			__path__    = "/var/log/syslog",
			instance    = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname),
			job         = "/var/log/syslog",
		},
	]
	sync_period = "60s"
}

loki.source.file "syslog" {
	targets       = local.file_match.syslog.targets
	forward_to    = [loki.process.syslog.receiver]
	tail_from_end = true
}

loki.process "syslog" {
	stage.static_labels {
		values = {
			log_type = "syslog",
			source   = "syslog",
		}
	}
	forward_to = [loki.process.log_processor.receiver]
}

// ============================================================================
// NETWORK SYSLOG — devices that cannot run an agent
// ============================================================================
//
// morpheus terminates every VLAN in this lab, which makes it the only device
// that sees inter-VLAN and egress traffic for the whole house. It is also a
// FreeBSD appliance that cannot run Alloy. Until this listener existed, Loki
// held auth.log from two Linux hosts and nothing from the firewall.
//
// pfSense reaches this on the management VLAN, where it already has an
// interface (10.0.99.1), so no firewall rule is required.
//
// UDP and RFC3164 because that is what pfSense sends by default.
//
// use_incoming_timestamp is DELIBERATELY false. RFC3164 carries neither a year
// nor a timezone, and trusting a timestamp with neither is how the first
// deployment of this listener failed. Measured on the wire:
//
//   <134>Aug 20 20:25:28 filterlog[97178]: 4,,,1000000103,em0,match,block,in,...
//
// captured at 03:25:28 UTC. morpheus runs on local time, seven hours behind, and
// says nothing about it — so an incoming timestamp is wrong by the UTC offset
// even in the best case, and the best case is not what happened. Loki accepted
// every push with a 204, discarded nothing (loki_discarded_samples_total never
// incremented), and no query over any range returned a single line. The entries
// were stored at a timestamp no sane query window covers.
//
// A year-zero time.Time is the likely culprit and it does not fail loudly:
// Go documents UnixNano as undefined outside 1678-2262, so it overflows int64
// and wraps rather than reading as obviously ancient. Nothing rejects it.
//
// rfc3164_default_to_current_year stays on — it is still correct about the year,
// and it costs nothing — but it is no longer load-bearing. Alloy now stamps
// receive time instead. morpheus is one hop away on the same VLAN, so that is
// accurate to milliseconds, and it is a value this stack can reason about.
loki.source.syslog "network" {
	listener {
		address                         = "0.0.0.0:1514"
		protocol                        = "udp"
		syslog_format                   = "rfc3164"
		rfc3164_default_to_current_year = true
		use_incoming_timestamp          = false

		labels = {
			log_type = "syslog",
			source   = "network",
		}
	}

	relabel_rules = loki.relabel.network_syslog.rules
	forward_to    = [loki.process.network_syslog.receiver]
}

// forward_to is empty on purpose: this component exists only to supply .rules
// to the listener above.
loki.relabel "network_syslog" {
	forward_to = []

	// The SENDING device's hostname becomes `host`. This is the reason
	// loki.write.network_syslog below exists — see the comment there.
	//
	// pfSense does not send one. RFC3164 is <PRI>TIMESTAMP HOSTNAME TAG:, and
	// what arrives on the wire is:
	//
	//   <134>Aug 20 20:25:28 filterlog[97178]: 4,,,1000000103,em0,match,block,...
	//
	// Timestamp straight to tag, no hostname field. So __syslog_message_hostname
	// is empty, Loki drops empty labels, and the streams carried no `host` at
	// all — which is why {host="morpheus"} returned nothing and looked for all
	// the world like the logs were not arriving.
	//
	// The connection address supplies it instead. Order matters: this rule sets
	// the default, and the rule below overrides it only when the message
	// actually carries a hostname. One value per sender, so no cardinality cost.
	rule {
		source_labels = ["__syslog_connection_ip_address"]
		regex         = "10\\.0\\.99\\.1"
		target_label  = "host"
		replacement   = "morpheus"
	}

	// `(.+)` is load-bearing, not decoration. A relabel rule whose regex does
	// not match is a no-op, so an empty message hostname leaves the name derived
	// above intact. With the default regex of `(.*)` this would match the empty
	// string and blank the label back out.
	rule {
		source_labels = ["__syslog_message_hostname"]
		regex         = "(.+)"
		target_label  = "host"
		replacement   = "$1"
	}

	// pfSense tags filterlog, dhcpd, unbound, sshd and so on. Low cardinality,
	// and it is how you separate firewall decisions from everything else.
	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "app"
	}

	// Severity from the syslog PRI, rather than regex-sniffing the message the
	// way log_processor has to for file sources. The protocol already carries
	// it; there is no reason to guess.
	//
	// But the PRI is MAPPED onto the five canonical levels here, not copied.
	// Copying it is what #83 was: the wire gives RFC5424 severity names, so
	// pfSense's traffic landed at `informational` and `notice`, neither of which
	// is a value the Logs dashboard's level picker offers. 3798 lines an hour
	// sat outside a filter whose setting said "All". docs/observability.md has
	// documented this five-value vocabulary all along; this path just never
	// honoured it, because it never passes through log_processor.
	//
	// Three things about the shape below, each of which is a trap:
	//
	//   - ORDER MATTERS ONLY IN THAT THE FIRST RULE IS FIRST. It is the default,
	//     and the four after it override it when they match. The overrides are
	//     mutually exclusive — relabel regexes are fully anchored — so their
	//     order relative to each other is free. This is the same idiom as the
	//     `host` rules above.
	//   - THE DEFAULT IS A LITERAL `info`, NOT A COPY OF THE SEVERITY. That is
	//     what makes the vocabulary closed: a severity nobody anticipated lands
	//     inside the five values instead of leaking a sixth one out to Loki,
	//     which is exactly how #83 happened. It is the same decision as
	//     log_processor's `{{ else }}info{{ end }}`.
	//   - `.+` NOT `.*`, for the reason spelled out against `host` above. `.*`
	//     matches the empty string, so a message with no severity at all would
	//     be stamped `info` — inventing a value rather than leaving the label
	//     unset. Absent is visibly absent; wrong is not.
	//
	// Both long and short spellings are in every alternation. What arrives today
	// is the long RFC5424 names, but hard-coding that observation is precisely
	// how this class of bug recurs, and a static regex costs nothing.
	//
	// One-way, and worth knowing during an incident: unlike the file sources,
	// where the original word survives in the line body, the PRI is consumed by
	// the parser and is not in the stored line. After this, `notice` and
	// `informational` are `info` and the raw severity exists nowhere in Loki.
	rule {
		source_labels = ["__syslog_message_severity"]
		regex         = ".+"
		target_label  = "level"
		replacement   = "info"
	}

	rule {
		source_labels = ["__syslog_message_severity"]
		regex         = "emergency|emerg|alert|critical|crit"
		target_label  = "level"
		replacement   = "critical"
	}

	rule {
		source_labels = ["__syslog_message_severity"]
		regex         = "error|err"
		target_label  = "level"
		replacement   = "error"
	}

	rule {
		source_labels = ["__syslog_message_severity"]
		regex         = "warning|warn"
		target_label  = "level"
		replacement   = "warning"
	}

	rule {
		source_labels = ["__syslog_message_severity"]
		regex         = "debug|dbug|dbg"
		target_label  = "level"
		replacement   = "debug"
	}
}

loki.process "network_syslog" {
	forward_to = [loki.write.network_syslog.receiver]

	// pfSense filterlog is CSV inside the syslog message:
	//
	//   rulenr,subrulenr,anchor,tracker,interface,reason,action,direction,
	//   ipversion,tos,ecn,ttl,id,offset,flags,protoid,proto,length,
	//   src,dst,srcport,dstport,...
	//
	// Only the first eight fields are captured. src, dst and the ports are
	// deliberately NOT promoted to labels — ADR-0003 records label cardinality
	// as this stack's live constraint, and a label per source address is the
	// textbook way to detonate it. They stay in the line, where LogQL can
	// filter them at query time without indexing them.
	// Suricata writes alerts to pfSense's system log, so they arrive on this same
	// listener once "System Events" is enabled in Remote Syslog Contents. Format:
	//
	//   [1:2013028:7] ET POLICY curl User-Agent Outbound
	//   [Classification: Attempted Information Leak] [Priority: 2]
	//   {TCP} 10.0.20.5:443 -> 203.0.113.9:80
	//
	// priority and classification become labels — 4 and ~40 values respectively.
	// The signature ID does not: there are tens of thousands of rules in ET Open,
	// and one label value per firing signature is the same cardinality mistake
	// as one per source address. It stays in the line.
	stage.match {
		selector = `{app="suricata"}`

		stage.regex {
			expression = `\[Classification: (?P<classification>[^\]]+)\] \[Priority: (?P<priority>\d+)\]`
		}

		stage.labels {
			values = {
				classification = "classification",
				priority       = "priority",
			}
		}
	}

	stage.match {
		selector = `{app="filterlog"}`

		stage.regex {
			expression = `^\d+,\d*,[^,]*,\d+,(?P<interface>[^,]+),(?P<reason>[^,]+),(?P<action>pass|block),(?P<direction>in|out),`
		}

		stage.labels {
			values = {
				interface = "interface",
				action    = "action",
				direction = "direction",
			}
		}
	}
}

// ============================================================================
// LOG PROCESSOR
// ============================================================================

loki.process "log_processor" {
	forward_to = [loki.write.grafana_loki.receiver]

	stage.regex {
		expression = `(?P<level_regex>(?i)\b(emerg|panic|corrupt|fatal|alert|crit|critical|err|eror|error|warn|warning|info|information|informational|notice|opened|closed|dbug|debug|dbg)\b)`
	}

	stage.template {
		source   = "level_lower"
		template = "{{ .level_regex | ToLower }}"
	}

	stage.template {
		source   = "level_parsed"
		template = `{{ if eq .level_lower "emerg" }}critical{{ else if eq .level_lower "panic" }}critical{{ else if eq .level_lower "corrupt" }}critical{{ else if eq .level_lower "fatal" }}critical{{ else if eq .level_lower "alert" }}critical{{ else if eq .level_lower "crit" }}critical{{ else if eq .level_lower "critical" }}critical{{ else if eq .level_lower "err" }}error{{ else if eq .level_lower "eror" }}error{{ else if eq .level_lower "error" }}error{{ else if eq .level_lower "warn" }}warning{{ else if eq .level_lower "warning" }}warning{{ else if eq .level_lower "info" }}info{{ else if eq .level_lower "information" }}info{{ else if eq .level_lower "informational" }}info{{ else if eq .level_lower "notice" }}info{{ else if eq .level_lower "dbug" }}debug{{ else if eq .level_lower "debug" }}debug{{ else if eq .level_lower "dbg" }}debug{{ else }}info{{ end }}`
	}

	stage.labels {
		values = {
			"level" = "level_parsed",
		}
	}
}

// ============================================================================
// REMOTE ENDPOINTS
// ============================================================================

loki.write "grafana_loki" {
	endpoint {
		url = coalesce(sys.env("LOKI_URL"), "http://loki:3100/loki/api/v1/push")
	}
	external_labels = {
		host = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname),
	}
}

// Network syslog is written through its own client, deliberately.
//
// loki.write.grafana_loki stamps the agent host label on everything it
// sends, which is correct for logs this machine produces and wrong for logs it
// merely relays. Reusing it would relabel every pfSense line as though it came
// from prometheus, and {host="morpheus"} would return nothing at all.
//
// No external_labels here, so the `host` set from the sender's own hostname in
// loki.relabel.network_syslog survives to Loki.
loki.write "network_syslog" {
	endpoint {
		url = coalesce(sys.env("LOKI_URL"), "http://loki:3100/loki/api/v1/push")
	}
}

prometheus.remote_write "metrics_service" {
	endpoint {
		url = coalesce(sys.env("PROMETHEUS_REMOTE_WRITE_URL"), "http://prometheus:9090/api/v1/write")
	}
	external_labels = {
		host = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname),
	}
}
