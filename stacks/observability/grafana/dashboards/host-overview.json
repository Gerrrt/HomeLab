{
  "uid": "homelab-host-overview",
  "title": "Host Overview",
  "description": "Per-host CPU, memory, storage and network for every machine running a Grafana Alloy agent. Metrics arrive by remote_write, so a host appears here as soon as its agent starts.",
  "tags": [
    "homelab",
    "hosts",
    "node-exporter"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "instance"
        },
        "definition": "label_values(node_uname_info, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "regex": "",
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "allValue": ".+"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Host alerts",
      "description": "One row per firing or pending alert, always the same six columns. Raw, each rule's own labels became a column apiece, empty on most rows (#888). Host is the first of host, instance. Subject is every identifying label the alert carries, in the order guest, zpool, pool, vg, vdev, kind, space, mountpoint, slot, device, model, power_supply, file, name, state, aux, via, written as \"name value\" and comma-separated, so two alerts that differ in any of them stay two rows. Either column reads — when the alert has none. The full label set is in Alertmanager.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (alertname, alertstate, severity, category, where, subject) (label_replace(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_replace(label_join(label_replace(label_join(ALERTS{component=\"host\",alertstate=~\"firing|pending\"}, \"fold_tmp\", \"|\", \"where\", \"host\"), \"where\", \"$1\", \"fold_tmp\", \"\\\\|(.+)\"), \"fold_tmp\", \"|\", \"where\", \"instance\"), \"where\", \"$1\", \"fold_tmp\", \"\\\\|(.+)\"), \"where\", \"—\", \"where\", \"\"), \"fold_tmp\", \"|\", \"subject\", \"guest\"), \"subject\", \"guest $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, guest $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"zpool\"), \"subject\", \"zpool $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, zpool $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"pool\"), \"subject\", \"pool $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, pool $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"vg\"), \"subject\", \"vg $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, vg $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"vdev\"), \"subject\", \"vdev $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, vdev $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"kind\"), \"subject\", \"kind $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, kind $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"space\"), \"subject\", \"space $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, space $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"mountpoint\"), \"subject\", \"mountpoint $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, mountpoint $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"slot\"), \"subject\", \"slot $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, slot $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"device\"), \"subject\", \"device $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, device $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"model\"), \"subject\", \"model $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, model $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"power_supply\"), \"subject\", \"power_supply $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, power_supply $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"file\"), \"subject\", \"file $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, file $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"name\"), \"subject\", \"name $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, name $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"state\"), \"subject\", \"state $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, state $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"aux\"), \"subject\", \"aux $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, aux $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"fold_tmp\", \"|\", \"subject\", \"via\"), \"subject\", \"via $1\", \"fold_tmp\", \"\\\\|(.+)\"), \"subject\", \"$1, via $2\", \"fold_tmp\", \"(.+)\\\\|(.+)\"), \"subject\", \"—\", \"subject\", \"\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2,
              "category": 3,
              "where": 4,
              "subject": 5
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "severity": "Severity",
              "category": "Category",
              "where": "Host",
              "subject": "Subject"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      },
                      "info": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "color": "yellow",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Severity"
          }
        ]
      }
    },
    {
