  "panels": [
    {
      "type": "table",
      "title": "Security alerts",
      "description": "Firing and pending alerts for the five Loki rules this dashboard charts, plus SuricataStopped — the process-table rule that says whether the IDS behind the Suricata panels is running at all — from the ALERTS series Prometheus exposes for its own rules. Scoped by alertname rather than component=logs, which would also pull in the SSH and auth rules that belong to the Logs dashboard. Empty is the good state. Silences live in Alertmanager and are not reflected here — see dashboards/README.md.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
