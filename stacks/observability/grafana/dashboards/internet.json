  "panels": [
    {
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Slow test, WAN busy** → something in the house is filling the link; the Network dashboard's per-port throughput names it. **Slow test, WAN quiet** → beyond the house — but check **WAN receive errors** first: on 2026-10-05 a corrupting cable between the XB7 and morpheus cut downloads to ~2 Mbit/s while uploads ran at ~297 (#914). **Latency climbs only during tests** → bufferbloat. The download ceiling is ~940 Mbit/s, not the plan's 2000: morpheus's WAN port is 1000baseT."
      },
      "targets": []
    },
    {
      "type": "stat",
      "title": "Latest download",
      "description": "The most recent completed Ookla test.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 100000000
              },
              {
                "color": "green",
                "value": 400000000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
