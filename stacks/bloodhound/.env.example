# Non-sensitive tunables for the bloodhound stack.
#
# Edit this file, not .env: `make up STACK=bloodhound` (render-config.sh)
# regenerates .env from it. The stack's five secrets — the two database
# passwords, the first admin's password, the session signing key and the
# ingest token — are in secrets/bloodhound.sops.yaml, not here. There is
# nothing here that may not be public.

# The UI, over TLS on the estate CA's leaf. Reached from Hicks over the
# existing Hicks -> ImaginationLAN rule (ADR-0031); nothing else needs it.
BIND_ADDR=0.0.0.0
BLOODHOUND_PORT=8443
# The name on the leaf, and what BloodHound puts in the links it generates.
# The leaf carries 10.0.30.41 as an IP SAN too, so the address works in a
# browser with no DNS override.
BLOODHOUND_HOSTNAME=bloodhound.matrix.elysium

# Where eden's second disk is mounted. postgres/, neo4j/ and work/ live under
# it, each owned by the uid its service runs as.
BLOODHOUND_DATA_DIR=/srv/bloodhound-data

# Where this guest's Alloy pushes: alexander, the lab's own stores (ADR-0007).
LAB_HOST=10.0.30.40
LAB_PROMETHEUS_PORT=9090
LAB_LOKI_PORT=3100

# render-config.sh writes ALLOY_HOSTNAME from `hostname` as well; set here too
# so the value is right before the first render.
ALLOY_HOSTNAME=eden
LOG_READ_GID=4

# Alloy's debug UI, pinned to 127.0.0.1 in compose.yaml.
ALLOY_PORT=12345
