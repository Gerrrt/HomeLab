# Non-sensitive tunables for the SOC stack.
#
# Edit this file, not .env — scripts/render-config.sh regenerates .env from it
# on every `make up STACK=soc`. Secrets do NOT belong here; see secrets/README.md
# and secrets/soc.example.yaml.

# Address the published ports bind to. odin is single-homed on VLAN 30 (no
# trunk, no VLAN-aware bridge — ADR-0007), so 0.0.0.0 means ImaginationLAN and
# nothing else; there is no second interface for it to reach further on.
BIND_ADDR=0.0.0.0

# Wazuh: agent traffic and enrolment, for the six domain machines (ADR-0029).
# Both are intra-segment, so neither needs a firewall rule (ADR-0030).
WAZUH_AGENT_PORT=1514
WAZUH_ENROL_PORT=1515

# The Wazuh dashboard, opened from a browser on Hicks over the 50 -> 30 rule
# that already exists. 5601 inside the container; 443 on the wire, as upstream.
WAZUH_DASHBOARD_PORT=443

# Velociraptor: the client frontend (the six endpoints), the GUI (a browser on
# Hicks) and the metrics listener (the lab's Prometheus on alexander). The
# container-side ports are fixed in velociraptor/init.vql; these are the
# host-side numbers only.
VELOCIRAPTOR_FRONTEND_PORT=8000
VELOCIRAPTOR_GUI_PORT=8889
VELOCIRAPTOR_METRICS_PORT=8003

# What the six clients dial, compiled into every client config. An address
# rather than a name on purpose — compose.yaml says why. Changing it after the
# first start changes nothing: the value is baked into server.config.yaml and
# into every client already deployed.
VELOCIRAPTOR_HOSTNAME=10.0.30.60

# Where this guest's Alloy pushes: alexander, the lab's own stores. These are
# the ports the runbook uncomments in stacks/lab on the day (ADR-0030 —
# "the lab's Prometheus and Loki become published for the first time").
# Nothing here points at 10.0.99.20, and nothing may.
LAB_HOST=10.0.30.40
LAB_PROMETHEUS_PORT=9090
LAB_LOKI_PORT=3100

# Alloy's debug UI, pinned to 127.0.0.1 in compose.yaml.
ALLOY_PORT=12345

# ALLOY_HOSTNAME is NOT set here. scripts/render-config.sh writes it from
# `hostname` at render time — it differs per monitored host, and setting it
# here would pin every host to the same name.
