// =============================================================================
// The one crossing between the two stores, running the direction ADR-0030
// allows: the Wazuh indexer's HEALTH into the lab's Prometheus on alexander.
//
// Not its alerts — those stay in the indexer, where the fields are typed, and
// tailing alerts.json into Loki was refused for duplicating every event into
// a second store with a second retention. What crosses is cluster status,
// heap, shard count and indexing rate: what the retention re-derivation in
// ADR-0030 needs, and what says "the SIEM stopped ingesting". A store that
// quietly stops ingesting is the #62/#63 shape this repository keeps paying
// for, and it is the one thing worth alerting on across the boundary. The
// rules that read these series live in stacks/lab/prometheus/rules/soc.rules.yaml,
// because the lab's Prometheus is where they arrive.
//
// This file lives in stacks/soc/alloy/ and NOT beside config.alloy in
// stacks/observability/alloy/: the estate's Alloy mounts that whole directory,
// and a copy there would load on VLAN 99 pointing at an OpenSearch that does
// not exist — a healthy exporter collecting nothing, one layer along.
//
// First-party component, no new image. It speaks to OpenSearch the way it
// speaks to Elasticsearch; the exporter it wraps documents "reasonable
// attempts to maintain compatibility with both".
// =============================================================================

prometheus.exporter.elasticsearch "wazuh_indexer" {
	address = "https://wazuh.indexer:9200"
	timeout = "10s"

	// Verified against the indexer's own root CA, mounted by compose.yaml —
	// the same standard the lab's Prometheus holds its Grafana scrape to.
	// ssl_skip_verify is deliberately absent.
	ca = "/etc/alloy/tls/root-ca.pem"

	// Per-index stats are on for ONE series family: how many documents the
	// alerts indices took. Node stats sum every writer, and filebeat is not the
	// only one. The dashboard bulk-writes wazuh-monitoring every 15 minutes and
	// wazuh-statistics every 5 (the pinned plugin's defaults), so a dead
	// filebeat never brought the node-wide count to zero, and
	// WazuhIngestionStalled could not see it. WazuhAlertsNotIndexed reads the
	// alerts indices alone.
	//
	// `indices = true` exposes about 78 families per index (exporter v1.5.0),
	// which is the cardinality this used to refuse: a question (which index is
	// how big) that ADR-0030 answers with one _cat/indices call. So
	// prometheus.relabel below drops every per-index series except
	// elasticsearch_index_stats_indexing_index_total on wazuh-alerts-*, about
	// thirty series at the 30-day retention. The cost of the exporter reading
	// _all/_stats each minute stays on odin.
	indices = true

	basic_auth {
		username = "admin"
		password = sys.env("INDEXER_PASSWORD")
	}
}

discovery.relabel "wazuh_indexer" {
	targets = prometheus.exporter.elasticsearch.wazuh_indexer.targets

	// A fixed job name rather than the "<host>-metrics" shape config.alloy
	// uses: the rules in stacks/lab key on it, and a rule that keys on a
	// hostname is a rule that breaks when the guest is rebuilt under another.
	rule {
		target_label = "job"
		replacement  = "wazuh-indexer"
	}

	rule {
		target_label = "instance"
		replacement  = coalesce(sys.env("ALLOY_HOSTNAME"), constants.hostname)
	}
}

prometheus.scrape "wazuh_indexer" {
	scrape_interval = "60s"
	targets         = discovery.relabel.wazuh_indexer.output
	forward_to      = [prometheus.relabel.wazuh_indexer.receiver]
}

// Every per-index series carries an `index` label. Node and cluster series
// don't, so they pass untouched, including the node-wide
// elasticsearch_indices_indexing_index_total that WazuhIngestionStalled reads.
// RE2 has no negative lookahead, so the one series to keep is marked first,
// every other series with an `index` label is dropped, and the mark goes.
prometheus.relabel "wazuh_indexer" {
	forward_to = [prometheus.remote_write.metrics_service.receiver]

	rule {
		source_labels = ["__name__", "index"]
		separator     = "@"
		regex         = "elasticsearch_index_stats_indexing_index_total@wazuh-alerts-.+"
		target_label  = "__keep_alerts_index"
		replacement   = "1"
	}

	rule {
		source_labels = ["index", "__keep_alerts_index"]
		separator     = "@"
		regex         = ".+@"
		action        = "drop"
	}

	rule {
		regex  = "__keep_alerts_index"
		action = "labeldrop"
	}
}
