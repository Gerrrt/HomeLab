# Non-sensitive tunables for the analyst stack, on garuda.
#
# Edit this file, not .env: `make up STACK=analyst` (render-config.sh)
# regenerates .env from it. The stack's one secret, its ingest token (#834), is
# in secrets/analyst.sops.yaml, not here. There is nothing here that may not be
# public.

# Where this guest's Alloy pushes: alexander, the lab's own stores (ADR-0007).
LAB_HOST=10.0.30.40
LAB_PROMETHEUS_PORT=9090
LAB_LOKI_PORT=3100

# render-config.sh writes ALLOY_HOSTNAME from `hostname` as well; set here too
# so the value is right before the first render.
ALLOY_HOSTNAME=garuda
LOG_READ_GID=4

# Alloy's debug UI, pinned to 127.0.0.1 in compose.yaml.
ALLOY_PORT=12345
