# Non-sensitive tunables for the sensitive stack.
#
# Edit this file, not .env — scripts/render-config.sh regenerates .env from it
# on every `make up STACK=sensitive`. Secrets do NOT belong here; see secrets/README.md.

# The address Caddy binds. 0.0.0.0 on trinity means its one interface on
# Winterfell, 10.0.99.40 — the host is single-homed, so there is nothing else
# it could mean — and the firewall decides who reaches it: Hicks, on the named
# list ADR-0031 records, and nothing from any other segment.
BIND_ADDR=0.0.0.0

# The only published port on the tier (ADR-0008, #129). 80 is deliberately not
# published: nothing off-host consumes it (ADR-0012) — a browser on Hicks types
# https, and step-ca's ACME challenge runs over 443 (tls-alpn-01). Publish it
# the day a redirect is wanted, and add the line to compose.yaml's `ports:`
# in the same commit, not before.
HTTPS_PORT=443

# ALLOY_HOSTNAME is deliberately absent — render-config.sh writes it from
# `hostname`, so the agent labels this host as trinity and not as a container
# id. The agent itself is not in this stack: trinity runs one the way oracle
# does, shipped by scripts/deploy-agent.sh, pushing to 10.0.99.20.

# ---------------------------------------------------------------------------
# Paperless-ngx (#133)
# ---------------------------------------------------------------------------

# The URL the browser uses, which is also what Django trusts: PAPERLESS_URL
# sets ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS in one go, so a browser reaching
# the service under any other name gets a 400 on the page and a 403 on every
# form. Reaching it under this one needs a host override on morpheus
# (paperless.matrix.elysium → 10.0.99.40, the seventh of ADR-0010's six) and,
# until step-ca issues a leaf per service, the name as a SAN on trinity's
# hand-issued certificate — compose.yaml carries the `make certs` line.
PAPERLESS_URL=https://paperless.matrix.elysium

# The superuser created on first start; its password is PAPERLESS_ADMIN_PASSWORD
# in SOPS. Changing this after first start creates a SECOND superuser rather
# than renaming the first.
PAPERLESS_ADMIN_USER=admin

# Documents are dated in local time. The house is seven hours behind UTC —
# ship-firewall-logs.md measured that on morpheus — and this is the zone that
# says so all year.
PAPERLESS_TIME_ZONE=America/Los_Angeles

# Tesseract's three-letter codes, `+`-joined for more than one (eng+deu). The
# image ships English, German, French, Italian and Spanish; anything else is
# PAPERLESS_OCR_LANGUAGES, which installs the pack at start as root — and this
# container runs as the operator, so a sixth language is a decision about
# `user:` in compose.yaml first.
PAPERLESS_OCR_LANGUAGE=eng

# How much of the box OCR is asked to take. One document at a time, three of
# its pages in parallel: the product is under compose.yaml's `cpus: 4`
# ceiling, so a backlog scan saturates its own allowance and not the tier's.
# Raise workers to consume several documents at once; raise threads to finish
# one long scan sooner. Upstream: keep the product at or under the core count.
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=3
