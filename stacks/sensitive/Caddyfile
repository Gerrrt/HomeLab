# The sensitive tier's front door. One file, reviewed like any other config:
# scripts/check_caddyfile.sh runs `caddy validate` and `caddy fmt` against it
# in `make validate` and CI, the way promtool checks the alert rules (#129).
#
# Routing lives here and nowhere else — not in per-service compose labels —
# so `git log` on this file is the history of what the tier serves.
{
	# No admin API. It would listen on 2019 inside the container, unauthenticated,
	# reachable by every other service on the `sensitive` network; the price is
	# that a change here is `make up STACK=sensitive`, not `caddy reload`.
	admin off

	# The container's own healthcheck connects to https://localhost, whose SNI
	# matches no site below; without a default, that handshake has no
	# certificate to offer and the check fails on a proxy that is serving fine.
	default_sni trinity.matrix.elysium
}

# Everything the tier serves, under one leaf for now. The certificate comes
# from scripts/gen-certs.sh (see compose.yaml); when step-ca's ACME provisioner
# is configured (#130) the `tls` line becomes
#
#	tls {
#		ca https://step-ca:9000/acme/acme/directory
#		ca_root /etc/caddy/tls/ca.pem
#	}
#
# and each service gets a name of its own beneath matrix.elysium, issued and
# renewed without a runbook step.
https:// {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem

	# What the container's healthcheck asks for, on any Host.
	handle /healthz {
		respond "ok" 200
	}

	# One block per service, matched on Host. Each name needs two things
	# outside this file: a SAN on the leaf (compose.yaml's `make certs` line)
	# and a host override on morpheus pointing it at 10.0.99.40
	# (docs/runbooks/add-a-host-override.md) — a Host the leaf does not carry
	# fails the handshake, and a name the resolver does not know never arrives.
	#
	# Home Assistant (#134). Its frontend runs over a websocket, which
	# reverse_proxy upgrades without being told; nothing here needs a header
	# Caddy does not already set — X-Forwarded-For is what its
	# `trusted_proxies` line reads, and Caddy's fixed address is what it trusts.
	@homeassistant host homeassistant.matrix.elysium
	handle @homeassistant {
		reverse_proxy home-assistant:8123
	}

	# AdGuard Home's UI (#135). Plain HTTP on the compose network; the DNS
	# side of the same container is published on 53 directly, because DNS is
	# not something this proxy can carry — compose.yaml, DIFFERENCE 7.
	@adguard host adguard.matrix.elysium
	handle @adguard {
		reverse_proxy adguard:80
	}

	# Paperless-ngx (#133). reverse_proxy sets X-Forwarded-For, -Proto and
	# -Host unasked, and compose.yaml's PAPERLESS_USE_X_FORWARD_HOST and
	# PAPERLESS_PROXY_SSL_HEADER are what reads them — Django otherwise sees a
	# plain-http request for the upstream's own name and rejects every POST.
	@paperless host paperless.matrix.elysium
	handle @paperless {
		reverse_proxy paperless:8000
	}

	# Vaultwarden (#131). Plain HTTP on the stack network; TLS ends here. Rocket
	# serves the Bitwarden API, the web vault and the WebSocket notifications
	# hub on the one port, and reverse_proxy upgrades WebSocket connections
	# without being told to. 8080 is compose.yaml's ROCKET_PORT; X-Forwarded-For
	# is what its IP_HEADER reads.
	@vaultwarden host vaultwarden.matrix.elysium
	handle @vaultwarden {
		reverse_proxy vaultwarden:8080
	}

	# ntfy and Homepage (#136, #137) add a block of the same
	# shape above this line. What matches nothing lands here.
	handle {
		respond "trinity: the sensitive tier. Nothing is routed under this name." 404
	}

	log {
		output stdout
		format json
	}
}
