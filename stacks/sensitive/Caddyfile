# The sensitive tier's front door. One file, reviewed like any other config:
# scripts/check_caddyfile.sh runs `caddy validate` and `caddy fmt` against it
# in `make validate` and CI, the way promtool checks the alert rules (#129).
#
# Routing lives here and nowhere else — not in per-service compose labels —
# so `git log` on this file is the history of what the tier serves.
{
	# No admin API. It would listen on 2019 inside the container, unauthenticated,
	# reachable by every other service on the `sensitive` network; the price is
	# that a change here is `make up STACK=sensitive`, not `caddy reload`.
	admin off

	# The container's own healthcheck connects to https://localhost, whose SNI
	# matches no site below. default_sni covers a ClientHello with no SNI at
	# all; fallback_sni covers one whose SNI matches nothing — busybox wget
	# sends `localhost`, which is the second case. Without both, that
	# handshake has no certificate to offer and the check fails on a proxy
	# that is serving fine.
	default_sni trinity.matrix.elysium
	fallback_sni trinity.matrix.elysium

	# 80 is not published (ADR-0012, .env.example), so the HTTP→HTTPS redirect
	# Caddy would otherwise listen for on it is a listener nothing can reach.
	# Disabled so the container's open ports are the ones compose.yaml says.
	auto_https disable_redirects

	# Every certificate this file serves comes from step-ca over ACME, from
	# the tier's own intermediate (ADR-0035, #130). `step-ca` resolves on the
	# compose network; the directory URL's middle segment is the provisioner
	# name scripts/tier-ca.sh creates. trusted_roots is the TIER'S root — the
	# file compose.yaml mounts from certificates/tier-ca.pem — not the estate's
	# ca.pem, which is a different CA and would reject the directory's
	# certificate. The http-01 challenge is disabled here as well as at the
	# CA: 80 is not published (ADR-0012), so leaving it enabled would only add
	# a failed attempt before the one that works.
	cert_issuer acme {
		dir https://step-ca:9000/acme/acme/directory
		trusted_roots /etc/caddy/tls/ca.pem
		disable_http_challenge
	}
}

# Each name served here is ALSO a network alias of the caddy service in
# compose.yaml — step-ca validates the tls-alpn-01 challenge by dialling the
# name on 443 from inside the compose network, and Docker's resolver answers
# with Caddy's address only for names Caddy carries. A block added here
# without its alias fails its first issuance with a DNS error at the CA.
#
# Nothing is routed yet. Each service from #131 onward gets a block of its
# own, under its own name and therefore its own certificate:
#
#	vaultwarden.matrix.elysium {
#		reverse_proxy vaultwarden:80
#	}
trinity.matrix.elysium {
	handle {
		respond "trinity: the sensitive tier. Nothing is routed under this name." 404
	}

	log {
		output stdout
		format json
	}
}

# Any other name, and the container's own healthcheck. No hostname, so
# automatic HTTPS obtains nothing for this block; the handshake is served
# with the fallback certificate above.
https:// {
	# What the container's healthcheck asks for, on any Host.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond "trinity: the sensitive tier. No such site." 404
	}
}
