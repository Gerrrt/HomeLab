# The sensitive tier's front door. One file, reviewed like any other config:
# scripts/check_caddyfile.sh runs `caddy validate` and `caddy fmt` against it
# in `make validate` and CI, the way promtool checks the alert rules (#129).
#
# Routing lives here and nowhere else — not in per-service compose labels —
# so `git log` on this file is the history of what the tier serves.
{
	# No admin API. It would listen on 2019 inside the container, unauthenticated,
	# reachable by every other service on the `sensitive` network; the price is
	# that a change here is `make up STACK=sensitive`, not `caddy reload`.
	admin off

	# The container's own healthcheck connects to https://localhost, whose SNI
	# matches no site below. default_sni covers a ClientHello with no SNI at
	# all; fallback_sni covers one whose SNI matches nothing — busybox wget
	# sends `localhost`, which is the second case. Without both, that
	# handshake has no certificate to offer and the check fails on a proxy
	# that is serving fine.
	default_sni trinity.matrix.elysium
	fallback_sni trinity.matrix.elysium

	# 80 is not published (ADR-0012, .env.example), so the HTTP→HTTPS redirect
	# Caddy would otherwise listen for on it is a listener nothing can reach.
	# Disabled so the container's open ports are the ones compose.yaml says.
	auto_https disable_redirects

	# Every certificate this file serves comes from step-ca over ACME, from
	# the tier's own intermediate (ADR-0037, #130). `step-ca` resolves on the
	# compose network; the directory URL's middle segment is the provisioner
	# name scripts/tier-ca.sh creates. trusted_roots is the TIER'S root — the
	# file compose.yaml mounts from certificates/tier-ca.pem — not the estate's
	# ca.pem, which is a different CA and would reject the directory's
	# certificate. The http-01 challenge is disabled here as well as at the
	# CA: 80 is not published (ADR-0012), so leaving it enabled would only add
	# a failed attempt before the one that works.
	cert_issuer acme {
		dir https://step-ca:9000/acme/acme/directory
		trusted_roots /etc/caddy/tls/ca.pem
		disable_http_challenge
	}
}

# Each name served here is ALSO a network alias of the caddy service in
# compose.yaml — step-ca validates the tls-alpn-01 challenge by dialling the
# name on 443 from inside the compose network, and Docker's resolver answers
# with Caddy's address only for names Caddy carries. A block added here
# without its alias fails its first issuance with a DNS error at the CA.
#
# One site block per service, under its own name and therefore its own
# certificate. The next service adds a block of the same shape, its alias in
# compose.yaml, and a host override on morpheus pointing the name at
# 10.0.99.40 (docs/runbooks/add-a-host-override.md) — a name the resolver
# does not know never arrives.
#
# Home Assistant (#134). Its frontend runs over a websocket, which
# reverse_proxy upgrades without being told; nothing here needs a header
# Caddy does not already set — X-Forwarded-For is what its `trusted_proxies`
# line reads, and Caddy's fixed address is what it trusts.
homeassistant.matrix.elysium {
	reverse_proxy home-assistant:8123

	log {
		output stdout
		format json
	}
}

# AdGuard Home's UI (#135). Plain HTTP on the compose network; the DNS side
# of the same container is published on 53 directly, because DNS is not
# something this proxy can carry — compose.yaml, DIFFERENCE 7.
adguard.matrix.elysium {
	reverse_proxy adguard:80

	log {
		output stdout
		format json
	}
}

# Immich (#132). The mobile app and the browser both talk to this name; the
# server takes uploads on the same port, and reverse_proxy imposes no body
# limit of its own.
immich.matrix.elysium {
	reverse_proxy immich-server:2283

	log {
		output stdout
		format json
	}
}

# Paperless-ngx (#133). reverse_proxy sets X-Forwarded-For, -Proto and -Host
# unasked, and compose.yaml's PAPERLESS_USE_X_FORWARD_HOST and
# PAPERLESS_PROXY_SSL_HEADER are what reads them — Django otherwise sees a
# plain-http request for the upstream's own name and rejects every POST.
paperless.matrix.elysium {
	reverse_proxy paperless:8000

	log {
		output stdout
		format json
	}
}

# Vaultwarden (#131). Plain HTTP on the stack network; TLS ends here. Rocket
# serves the Bitwarden API, the web vault and the WebSocket notifications hub
# on the one port, and reverse_proxy upgrades WebSocket connections without
# being told to. 8080 is compose.yaml's ROCKET_PORT; X-Forwarded-For is what
# its IP_HEADER reads.
vaultwarden.matrix.elysium {
	reverse_proxy vaultwarden:8080

	log {
		output stdout
		format json
	}
}

# Memos (#145, ADR-0059), the household's notes.
memos.matrix.elysium {
	reverse_proxy memos:5230

	log {
		output stdout
		format json
	}
}

# The household's front page. A short name on purpose: it is the one address
# on this tier that people who are not the operator are told. Since ADR-0103
# it is Glance's Household page, which Homepage (#137) used to be: the bare
# name lands there, and everything else is Glance, so the page's own assets
# and API calls resolve.
home.matrix.elysium {
	# The tier's root certificate, as a download, so a household phone can
	# install it before any app here is pointed at the tier
	# (build-the-tier-ca.md section 6). It is the same file compose.yaml mounts
	# for the ACME client, public by design: a root certificate vouches for the
	# tier and reveals nothing. The leaf's key, and the CA's, are elsewhere.
	handle /tier-ca.crt {
		root * /etc/caddy/tls
		rewrite * /ca.pem
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=matrix-elysium-tier-ca.crt"
		file_server
	}

	handle {
		redir / /household
		reverse_proxy glance:8080
	}

	log {
		output stdout
		format json
	}
}

# ntfy (#136). Alertmanager on prometheus publishes here and the phones
# subscribe here; a subscription is a long-lived HTTP stream or a WebSocket,
# and reverse_proxy carries both unasked. The access log records the request
# URI, which is why Alertmanager's token travels in an Authorization header
# and never as ntfy's `?auth=` parameter.
ntfy.matrix.elysium {
	reverse_proxy ntfy:8080

	log {
		output stdout
		format json
	}
}

# Miniflux (#147, ADR-0057). Plain HTTP on the stack network; TLS ends here.
# compose.yaml's BASE_URL is this name with https://, which is what Miniflux
# builds its links and its cookies' Secure flag from. The REST API is off
# (DISABLE_API), so everything under this name is the web UI and the two
# per-user sync APIs the ADR keeps off until a client wants them.
miniflux.matrix.elysium {
	reverse_proxy miniflux:8080

	log {
		output stdout
		format json
	}
}

# Mealie (#146, ADR-0060), the household's recipes. Named for what it is for,
# like `home`, because the people who use it will type it rather than find it.
# BASE_URL in compose.yaml is this name, so the links Mealie builds in shared
# recipes and invitations point here; X-Forwarded-For and -Proto are set
# unasked.
recipes.matrix.elysium {
	reverse_proxy mealie:9000

	log {
		output stdout
		format json
	}
}

# linkding (#144, ADR-0061). Django reads the scheme from the
# X-Forwarded-Proto Caddy sets, which is what lets a login POST from https://
# pass its CSRF check without a trusted-origins list.
links.matrix.elysium {
	reverse_proxy linkding:9090

	log {
		output stdout
		format json
	}
}

# Actual (#142, ADR-0062). The web app and the sync API its clients call are
# the same origin, so one block serves both. The server is claimed before its
# first start (scripts/seed-actual-password.sh), so there is never a moment
# when this name offers "set a password" to whoever arrives first.
#
# A request with any Content-Encoding is refused with 415, until the image
# ships body-parser 2.4.0 (#970). Actual parses every body before routing and
# auth, with inflation on, and 26.11.0's body-parser 2.3.0 lets one compressed
# body with trailing bytes crash the process (CVE-2026-111181). Turning
# inflation off is the advisory's workaround, and Actual has no setting for
# it. Actual's web client never compresses what it sends. Take this matcher
# out in the bump that clears #970.
actual.matrix.elysium {
	@encoded_body header Content-Encoding *
	respond @encoded_body "Compressed request bodies are refused here." 415

	reverse_proxy actual:5006

	log {
		output stdout
		format json
	}
}

# Stirling-PDF (#143, ADR-0063). Its uploads land on a 1 GiB tmpfs that is
# also the working space for every intermediate an OCR or a conversion
# writes (compose.yaml, DIFFERENCE 13), and Stirling sets no upload limit of
# its own. The cap here keeps one upload well under that space, so an
# oversized file is refused at the door with a 413 rather than filling
# the tmpfs halfway through a job. 256 MB is a very large scan; a household
# document is a few.
pdf.matrix.elysium {
	request_body {
		max_size 256MB
	}
	reverse_proxy stirling-pdf:8080

	log {
		output stdout
		format json
	}
}

# Glance (ADR-0098), the operator's browser start page. `proxied: true` in
# glance/glance.yml is what makes it read the X-Forwarded-* Caddy sets.
start.matrix.elysium {
	reverse_proxy glance:8080

	log {
		output stdout
		format json
	}
}

# The office wall dashboard (ADR-0119): a static page and the Prometheus
# answers it shows, served to `heimdall`'s kiosk and to anything else on a
# segment that reaches 443 here. Two halves, one rule between them:
#
#   /           the page, from stacks/sensitive/wall/, mounted read-only.
#   /api/q/NAME a FIXED question. Each handle below rewrites to one PromQL
#               query written in this file, and the reader token is added
#               here, server-side. The browser chooses which question, never
#               the query: the client's own query string is replaced by the
#               rewrite, so /api/q/cpu?query=anything still asks the CPU
#               question. Nothing else under /api/ answers. The reader token
#               can query and nothing more (ADR-0067); this narrows it again,
#               to eight answers. The page holds no credential, and neither
#               does the Pi.
#   /api/ha/NAME one Home Assistant entity's state, the same way: each handle
#               rewrites to /api/states/<one entity> and ends in `?`, which
#               drops the client's query string, and the `wall` user's token
#               is added here (the wall_ha snippet).
#
# The token is the one Glance already holds, GLANCE_PROMETHEUS_TOKEN, given
# to the caddy service in compose.yaml. It is the estate's READER, which
# Glance and Home Assistant already share, so rotating it is still the three
# edits secrets/sensitive.example.yaml lists. The upstream is the ingest proxy
# on `prometheus`, whose leaf the estate CA issued, so that CA is trusted for
# this one transport: the committed stacks/observability/alloy/ingest-ca.pem,
# mounted read-only, the same file render-trust-bundles.sh feeds Glance.
#
# Read-only by method as well: anything but GET or HEAD is refused before a
# handle runs. The CSP lets the page load only itself and fetch only itself,
# so a change to the page that reached for a CDN or a third-party API would
# fail in the browser rather than quietly leak a request.
(wall_prometheus) {
	reverse_proxy https://10.0.99.20:9090 {
		header_up Authorization "Bearer {$GLANCE_PROMETHEUS_TOKEN}"
		header_up -Cookie
		header_down -Set-Cookie
		transport http {
			tls_trust_pool file /etc/caddy/tls/ingest-ca.pem
		}
	}
}

# The household half of the wall page: Home Assistant, on this network, with
# the token of its non-admin `wall` user added here. HA has no read-only
# role, so the narrowing below is what makes this read-only: one GET of one
# entity's state per handle, and nothing else under /api/ha/.
(wall_ha) {
	reverse_proxy home-assistant:8123 {
		header_up Authorization "Bearer {$WALL_HA_TOKEN}"
		header_up -Cookie
		header_down -Set-Cookie
	}
}

wall.matrix.elysium {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# `route` keeps the order written: the method gate must run before any
	# handle, and Caddy would otherwise sort `respond` after `handle`. It
	# matters because Prometheus reads a POST body's `query=` ahead of the
	# URL's, so a POST through a rewrite could still ask its own question.
	route {
		@unsafe not method GET HEAD
		respond @unsafe 405

		# Every firing alert, Watchdog included: its absence means rule evaluation has stopped.
		#   ALERTS{alertstate="firing"}
		handle /api/q/alerts {
			rewrite * /api/v1/query?query=ALERTS%7Balertstate%3D%22firing%22%7D
			import wall_prometheus
		}

		# CPU busy per node_exporter host; a host that stops reporting drops out.
		#   100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])))
		handle /api/q/cpu {
			rewrite * /api/v1/query?query=100%20%2A%20%281%20-%20avg%20by%20%28instance%29%20%28rate%28node_cpu_seconds_total%7Bmode%3D%22idle%22%7D%5B5m%5D%29%29%29
			import wall_prometheus
		}

		# Whether each SNMP device answered its last poll: morpheus, mjolnir, neo, shiva.
		#   max by (device) (up{job="snmp"})
		handle /api/q/snmp {
			rewrite * /api/v1/query?query=max%20by%20%28device%29%20%28up%7Bjob%3D%22snmp%22%7D%29
			import wall_prometheus
		}

		# WAN traffic now, both directions (rules/internet.rules.yaml).
		#   homelab_wan_bits_per_second
		handle /api/q/wan {
			rewrite * /api/v1/query?query=homelab_wan_bits_per_second
			import wall_prometheus
		}

		# The last hour of download, for the sparkline: a range vector, so a matrix.
		#   homelab_wan_bits_per_second{direction="receive"}[1h:2m]
		handle /api/q/wan_hour {
			rewrite * /api/v1/query?query=homelab_wan_bits_per_second%7Bdirection%3D%22receive%22%7D%5B1h%3A2m%5D
			import wall_prometheus
		}

		# TCP connect time to 1.1.1.1:443, the internet anchor.
		#   probe_duration_seconds{job="blackbox-latency",name="cloudflare"}
		handle /api/q/rtt {
			rewrite * /api/v1/query?query=probe_duration_seconds%7Bjob%3D%22blackbox-latency%22%2Cname%3D%22cloudflare%22%7D
			import wall_prometheus
		}

		# Mjolnir: charge, runtime, time on battery, load.
		#   {__name__=~"upsEstimatedChargeRemaining|upsEstimatedMinutesRemaining|upsSecondsOnBattery|upsOutputPercentLoad",instance="10.0.99.10"}
		handle /api/q/ups {
			rewrite * /api/v1/query?query=%7B__name__%3D~%22upsEstimatedChargeRemaining%7CupsEstimatedMinutesRemaining%7CupsSecondsOnBattery%7CupsOutputPercentLoad%22%2Cinstance%3D%2210.0.99.10%22%7D
			import wall_prometheus
		}

		# Heimdall's own SoC temperature, for the status bar.
		#   max(node_thermal_zone_temp{instance="heimdall"})
		handle /api/q/pi_temp {
			rewrite * /api/v1/query?query=max%28node_thermal_zone_temp%7Binstance%3D%22heimdall%22%7D%29
			import wall_prometheus
		}

		# The header's weather: condition, temperature, humidity, wind.
		handle /api/ha/weather {
			rewrite * /api/states/weather.forecast_home?
			import wall_ha
		}

		# The Ring Alarm's mode, through a template entity in
		# home-assistant/packages/wall_house.yaml: the alarm's own id names the city.
		handle /api/ha/alarm {
			rewrite * /api/states/sensor.wall_alarm?
			import wall_ha
		}

		# Ring contact sensors: on is open.
		handle /api/ha/front_door {
			rewrite * /api/states/binary_sensor.front_door?
			import wall_ha
		}

		handle /api/ha/garage_door {
			rewrite * /api/states/binary_sensor.garage_door?
			import wall_ha
		}

		handle /api/ha/garden_door {
			rewrite * /api/states/binary_sensor.garden_door?
			import wall_ha
		}

		handle /api/ha/patio_door {
			rewrite * /api/states/binary_sensor.patio_door?
			import wall_ha
		}

		handle /api/ha/window_left {
			rewrite * /api/states/binary_sensor.window_left?
			import wall_ha
		}

		handle /api/ha/window_right {
			rewrite * /api/states/binary_sensor.window_right?
			import wall_ha
		}

		# The office lights, on when any is on, through a template entity in
		# home-assistant/packages/wall_house.yaml: their own ids name a person.
		handle /api/ha/office_light {
			rewrite * /api/states/binary_sensor.wall_office_lights?
			import wall_ha
		}

		# Today's and tomorrow's events, gathered from the calendars by
		# home-assistant/packages/wall_calendar.yaml. A calendar's own API needs
		# a moving start and end, which a fixed handle cannot give.
		handle /api/ha/today {
			rewrite * /api/states/sensor.wall_today?
			import wall_ha
		}

		handle /api/* {
			respond "no such question" 404
		}

		handle {
			root * /srv/wall
			file_server
		}
	}

	log {
		output stdout
		format json
	}
}

# The host's own name: nothing is served under it yet.
trinity.matrix.elysium {
	handle {
		respond "trinity: the sensitive tier. Nothing is routed under this name." 404
	}

	log {
		output stdout
		format json
	}
}

# Any other name, and the container's own healthcheck. No hostname, so
# automatic HTTPS obtains nothing for this block; the handshake is served
# with the fallback certificate above.
https:// {
	# What the container's healthcheck asks for, on any Host.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond "trinity: the sensitive tier. No such site." 404
	}
}
