# Non-sensitive tunables for the sensor stack.
#
# Edit this file, not .env: `make up STACK=sensor` (render-config.sh)
# regenerates .env from it. The stack's one secret, its ingest token (#834), is
# in secrets/sensor.sops.yaml, not here. There is nothing here that may not be
# public.

# The capture NIC: fenrir's net1, alone on Saruman's port-less vmbr1. Proxmox's
# second virtio NIC enumerates as ens19 on the default machine type; confirm
# with `ip -br link` on the guest and change it here if not.
ZEEK_INTERFACE=ens19

# fenrir's own address, on net0. Zeek drops it with a BPF filter: the mirror
# sees the replies to this guest's log shipping, and Zeek logging its own
# output is a feedback loop with nothing to learn from.
SENSOR_ADDR=10.0.30.90

# Where fenrir's second disk is mounted. Zeek's logs live in zeek/ under it.
SENSOR_DATA_DIR=/srv/sensor-data

# Where this guest's Alloy pushes: alexander, the lab's own stores (ADR-0007).
LAB_HOST=10.0.30.40
LAB_PROMETHEUS_PORT=9090
LAB_LOKI_PORT=3100

# render-config.sh writes ALLOY_HOSTNAME from `hostname` as well; set here too
# so the value is right before the first render.
ALLOY_HOSTNAME=fenrir
LOG_READ_GID=4

# Alloy's debug UI, pinned to 127.0.0.1 in compose.yaml.
ALLOY_PORT=12345
