# Non-sensitive tunables for the media stack.
#
# Edit this file, not .env — scripts/render-config.sh regenerates .env from it
# on every `make up STACK=media`. Secrets do NOT belong here; see
# secrets/README.md. This stack currently has none: Jellyfin's admin account is
# created through its own setup wizard on first run and lives in its database,
# not in an environment variable.

# The user Jellyfin runs as. Not root — the image declares no user and would
# run as root if this were unset, and nothing else in this estate does.
#
# 65534:65534 is nobody:nogroup, and it works here only because the pinned
# image ships /config and /cache world-writable (mode 777, measured — see the
# comment on the service). It has to be able to read MEDIA_PATH below, so if
# the library's permissions are tightened later, this is the pair that has to
# be given access rather than the mount being loosened.
JELLYFIN_UID=65534
JELLYFIN_GID=65534

# The group that owns /dev/dri/renderD128 ON THE HOST — a host fact, not an
# image one, which is why there is no sensible default to guess here. Getting
# it wrong does not fail loudly: Jellyfin falls back to software transcoding
# and one 4K stream saturates the box, which presents as "the film stutters"
# rather than as an error.
#
# Find it on smaug:
#
#   stat -c '%g %G' /dev/dri/renderD128
#
# ADR-0040's reopen condition turns on this working, and build-the-nas.md §6
# is where it gets tested rather than assumed.
#
# Read off smaug on 2026-09-16: `107 render`. That the node exists at all is
# worth noting — it means the kernel bound a driver to the P630 and exposed a
# render node, which is one more step of ADR-0040's condition standing up. The
# step it is NOT is a container using it, which is still §6's to prove.
RENDER_GID=107

# The library on erebor, mounted read-only into the container at /media.
#
# This is the dataset build-the-nas.md §4 creates with a 1M record size and
# deliberately does NOT back up — ADR-0008 ruled the library replaceable and
# its loss "annoying rather than catastrophic". Jellyfin's own state, which IS
# backed up, is the jellyfin-config volume and not this path.
MEDIA_PATH=/mnt/erebor/media

# The address Jellyfin's 8096 is published on.
#
# 0.0.0.0 on smaug means its one interface on CasaBonita, 10.0.40.30 — the host
# is single-homed, so there is nothing else it could mean, which is the same
# reasoning stacks/sensitive gives for Caddy's BIND_ADDR. Who may actually
# reach it is decided by placement and by one firewall rule, not by this line:
# every television on 40 reaches it natively on the same broadcast domain, a
# Hicks workstation reaches it through the rule in build-the-nas.md §0.5, and
# default deny sees to everything else.
JELLYFIN_BIND_ADDR=0.0.0.0
