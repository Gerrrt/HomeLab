# Non-sensitive tunables for the scratch stack.
#
# Edit this file, not .env — scripts/render-config.sh regenerates .env from it
# on every `make up STACK=scratch`. Secrets do NOT belong here; see
# secrets/README.md and secrets/scratch.example.yaml.

# Address the published ports bind to. diabolos is single-homed on VLAN 30, as
# odin is, so 0.0.0.0 means ImaginationLAN and nothing else.
BIND_ADDR=0.0.0.0

# Wazuh: agent traffic and enrolment, for whatever is being investigated.
WAZUH_AGENT_PORT=1514
WAZUH_ENROL_PORT=1515

# The Wazuh dashboard, from a browser on Hicks over the 50 -> 30 rule.
WAZUH_DASHBOARD_PORT=443

# Velociraptor: the client frontend and the GUI. No metrics port — nothing
# scrapes this guest (compose.yaml, DIFFERENCE 4).
VELOCIRAPTOR_FRONTEND_PORT=8000
VELOCIRAPTOR_GUI_PORT=8889

# What clients dial, compiled into every client config: this guest's address,
# never odin's.
VELOCIRAPTOR_HOSTNAME=10.0.30.61

# Where diabolos's second disk is mounted (run-a-scratch-investigation.md). The
# mountpoint is immutable when the disk is not mounted, so a missing mount
# stops `make up` instead of filling the OS disk.
SCRATCH_DATA_DIR=/srv/scratch-data
