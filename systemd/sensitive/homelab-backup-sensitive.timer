[Unit]
Description=HomeLab: nightly sensitive-tier volume backup
Documentation=file://@DEPLOY_ROOT@/docs/runbooks/restore-the-sensitive-tier.md

[Timer]
Unit=homelab-backup-sensitive.service
# Daily, not weekly like the estate's: this is the password vault, and a week
# of lost vault edits is the wrong default. KEEP=7 is then a week of sets here
# and on oracle. 04:30 is an hour clear of the monitoring host's Sunday 03:30
# backup, so the two copies to oracle never share its link.
OnCalendar=*-*-* 04:30:00
# No jitter, so the nightly outage has a stateable time.
RandomizedDelaySec=0
# False for the reason the monitoring host's backup is: a replay at boot would
# stop the tier moments after it came up. A missed night is inside the 2d
# threshold scripts/install-timers.sh declares for it.
Persistent=false
AccuracySec=1m

[Install]
WantedBy=timers.target
