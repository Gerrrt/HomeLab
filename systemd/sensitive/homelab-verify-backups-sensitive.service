# Nightly re-verification of trinity's backup sets, here and on oracle (#856).
#
# The same job as ../homelab-verify-backups.service, run against the other
# stack on the other host, and that unit (and homelab-backup-sensitive.service
# beside this one) explains every directive below; this one states only what
# differs. Before it, a set on trinity was verified on the night it was written
# and never again, and on this tier a set that rots unread is the vault's.
#
# `verify-backups STACK=sensitive` walks two kinds of set: the tier's volume
# sets in backups/volumes/ and Immich's library sets in backups/immich-library/
# (ADR-0064). Each is decrypted and read here. Then oracle is asked to sha256
# every archive it holds of them, and the answer is compared with each set's
# MANIFEST here, which is where oracle's copies are verified: from trinity,
# with nothing decrypted on oracle, which holds no key (ADR-0015). The same
# bytes as a set that has just decrypted here are the same backup.
#
# The `backups` lock, shared with homelab-backup-sensitive,
# homelab-backup-library and homelab-converge-sensitive: a backup's prune must
# not delete a set this is mid-read on.
[Unit]
Description=HomeLab: verify trinity's backup sets still decrypt, and oracle's copies still match
Documentation=file://@DEPLOY_ROOT@/docs/runbooks/restore-the-sensitive-tier.md
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
User=@RUN_USER@
Group=@RUN_GROUP@
SupplementaryGroups=docker
WorkingDirectory=@DEPLOY_ROOT@
Environment=STACK=sensitive
Environment=SOPS_AGE_KEY_FILE=@RUN_HOME@/.config/sops/age/keys.txt
EnvironmentFile=-/etc/default/homelab-timers
ExecStart=@DEPLOY_ROOT@/scripts/run-scheduled.sh --job verify-backups-sensitive --lock backups --lock-wait 900 -- /usr/bin/make -C @DEPLOY_ROOT@ verify-backups STACK=sensitive
TimeoutStartSec=1800
Restart=no
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
ProtectHome=false
ProtectSystem=false
PrivateTmp=false
NoNewPrivileges=true
# No RestrictSUIDSGID=, for homelab-backup-library.service's reason: the
# library's verification runs the host's tar, and under that filter tar fails
# `stat` on a plain-file operand with ENOSYS.
LockPersonality=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-verify-backups-sensitive

# No [Install] section: the timer enables this.
