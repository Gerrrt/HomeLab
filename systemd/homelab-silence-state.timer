[Unit]
Description=HomeLab: Alertmanager silences as metrics
Documentation=file:///home/robo/code/Gerrrt/HomeLab/docs/runbooks/schedule-maintenance.md

[Timer]
Unit=homelab-silence-state.service
# Every 15 minutes, offset from gateway-state's quarter-hours so the two
# sub-daily jobs do not start together. The cadence is set by
# SilenceWithoutIssue, which is meant to fire soon after a silence with no
# owner is created, not by SilenceExpiresSoon, which has a week of slack. A
# GET on loopback costs nothing; the journal line per run is the only weight.
OnCalendar=*:5/15
RandomizedDelaySec=60
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
