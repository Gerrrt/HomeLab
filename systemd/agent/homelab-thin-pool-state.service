# How full this hypervisor's LVM-thin pools are (#538).
#
# WHAT IT IS FOR. A thin pool is not a filesystem, so node_exporter never sees
# one and HostDiskCritical cannot fire for it — while a pool that fills turns
# every guest on it read-only at once. The collector reads `lvs` and writes
# data and metadata use per pool; ThinPoolNearlyFull and ThinPoolWillFillIn24h
# read the result.
#
# HARDENING AS LIGHT AS homelab-guest-state.service, AND FOR A RELATED REASON.
# `lvs` opens block devices under /dev and takes a lock under /run/lock/lvm, so
# PrivateDevices, ProtectSystem=strict and every other directive that builds a
# private mount namespace are the ones most likely to make it fail or lie. That
# unit learned what a namespace can hide on this host by reporting zero guests
# on a hypervisor that ran one; this one starts from its conclusion rather than
# rediscovering it. A failure is still loud: the collector writes nothing and
# ThinPoolStateStale fires.
#
# Root is needed for the reading itself this time, not only for the textfile
# directory.
[Unit]
Description=HomeLab: record how full this hypervisor's thin pools are
Documentation=file:///home/robo/code/Gerrrt/HomeLab/docs/runbooks/schedule-maintenance.md
ConditionPathIsDirectory=/var/lib/node_exporter/textfile_collector
ConditionPathExists=/usr/sbin/lvs

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/homelab-collect-thin-pool-state
TimeoutStartSec=120
Restart=no
Nice=10
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-thin-pool-state
