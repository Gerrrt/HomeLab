[Unit]
Description=HomeLab: hypervisor firewall state
Documentation=file:///home/robo/code/Gerrrt/HomeLab/docs/runbooks/schedule-maintenance.md

[Timer]
Unit=homelab-pve-firewall-state.service
# Every 5 minutes, the most frequent agent collector here, because
# PveFirewallDisabled is critical after ten: a firewall left off after a
# debugging session should be noticed in that session, and a daily sample would
# bound the alert by the timer rather than by the condition.
OnCalendar=*:0/5
RandomizedDelaySec=30
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
