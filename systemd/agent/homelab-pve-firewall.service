# Whether this hypervisor's Proxmox firewall is on, and holding a wall (#576).
#
# WHAT IT IS FOR. #566 found `Saruman`'s firewall disabled while two ADRs said
# the management-plane rule was standing, and turned it on. This is what notices
# the next time it is off: a `pve-firewall stop` left behind after debugging, an
# upgrade that rewrites /etc/pve/firewall, `policy_in` left at ACCEPT. It writes
# whether the firewall is enabled, whether the inbound policy drops, and how
# many rules each file holds.
#
# HARDENING AS LIGHT AS homelab-guest-state.service, AND FOR THE SAME REASON.
# cluster.fw and host.fw are under /etc/pve, which is pmxcfs — a FUSE mount —
# and a mount namespace can leave it invisible. A collector that cannot see the
# files would report zero rules, which is a reading this one treats as true.
# So no directive here creates a mount namespace.
#
# Root for the textfile directory and for `pve-firewall status`.
[Unit]
Description=HomeLab: record whether the Proxmox firewall is enabled
Documentation=file:///home/robo/code/Gerrrt/HomeLab/docs/runbooks/schedule-maintenance.md
ConditionPathIsDirectory=/var/lib/node_exporter/textfile_collector
ConditionPathExists=/usr/sbin/pve-firewall

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/homelab-collect-pve-firewall
TimeoutStartSec=120
Restart=no
Nice=10
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-pve-firewall
