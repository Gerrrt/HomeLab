[Unit]
Description=HomeLab: LVM-thin pool usage
Documentation=file:///home/robo/code/Gerrrt/HomeLab/docs/runbooks/schedule-maintenance.md

[Timer]
Unit=homelab-thin-pools.service
# Every 10 minutes, like guest-state and for a related reason: this feeds
# ThinPoolWillFillIn24h's predict_linear over six hours, and a daily sample
# would give that extrapolation nothing to fit. ThinPoolStateStopped allows an
# hour, which is six missed runs.
OnCalendar=*:0/10
RandomizedDelaySec=60
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
