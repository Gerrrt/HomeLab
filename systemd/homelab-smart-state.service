# Daily SMART collection for THIS HOST'S disks (#351).
#
# THE ONLY UNIT HERE THAT RUNS AS ROOT, and #351 called that out as the reason
# this was a provisioning change rather than a config change. Every other timer
# in install-timers.sh's JOBS table runs as User=robo. smartctl issues ATA and
# NVMe pass-through ioctls and needs raw device access; no group membership
# substitutes for it.
#
# ROOT UNIT RATHER THAN A SUDOERS RULE, deliberately. A NOPASSWD entry for
# smartctl is also one for `smartctl --set` and `smartctl -t`, which write to the
# drive and can start self-tests — so the narrow-looking option is not actually
# narrower. A unit that runs as root and gives back everything it does not need
# is easier to reason about than argument matching in sudoers:
# ProtectSystem=strict with a single ReadWritePaths, no network at all, and every
# kernel-surface toggle set.
#
# THIS UNIT DOES NOT TOUCH THE NETWORK, and that is the point of the split.
# morpheus is collected by homelab-smart-state-remote.service, which runs as robo
# because the key that reaches the firewall is robo's. One job used to do both
# and failed twice: as root it could not read that key, and dropping to robo with
# runuser hit NoNewPrivileges. Two units, each running as the user it needs, need
# none of that — and this one can therefore keep NoNewPrivileges and drop network
# access entirely, which the combined unit could not.
#
# It goes through run-scheduled.sh like every other job, which is what produces
# homelab_job_* and what install-timers.sh --check asserts for every ExecStart.
# Running as root changes who executes it, not how its outcome is recorded.
#
# See homelab-backup-volumes.service for why each directive below is set.
[Unit]
Description=HomeLab: collect SMART health for this host's disks
Documentation=file:///home/robo/code/Gerrrt/HomeLab/docs/runbooks/schedule-maintenance.md

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/robo/code/Gerrrt/HomeLab
EnvironmentFile=-/etc/default/homelab-timers
ExecStart=/home/robo/code/Gerrrt/HomeLab/scripts/run-scheduled.sh --job smart-state -- /usr/bin/make -C /home/robo/code/Gerrrt/HomeLab smart-state
TimeoutStartSec=300
Restart=no
Nice=10
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Reads local block devices and writes a textfile. It has no reason to talk to
# anything, and the unit that does is a different one.
PrivateNetwork=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-smart-state
