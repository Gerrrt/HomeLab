# The range's power-off backstop (ADR-0124, #1647). It runs on gandalf only,
# which has no checkout of this repository and no agent, so this unit calls
# the script directly, the way systemd/agent/ units do. Nothing reports its
# outcome to Prometheus: ADR-0017 gives the range no monitoring, and
# build-the-playground.md §7's read-back is what checks the timer is on.
#
# RUNS AS ROOT because powering off and writing to every terminal need it.
# The state directory under /run is the only path it writes. The directory
# is kept when the unit stops, because the deadline and the warnings
# already sent have to survive from one run to the next.
#
# The script is installed at /usr/local/sbin/homelab-range-poweroff by
# build-the-playground.md §7, which also installs this file.
[Unit]
Description=HomeLab: power gandalf off at the range deadline (ADR-0124)
Documentation=https://github.com/Gerrrt/HomeLab/blob/main/docs/runbooks/build-the-playground.md

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-range-poweroff check
TimeoutStartSec=60
Restart=no
RuntimeDirectory=homelab-range-poweroff
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-range-poweroff
