[Unit]
Description=HomeLab: daily SMART collection
Documentation=file:///home/robo/code/Gerrrt/HomeLab/docs/runbooks/schedule-maintenance.md

[Timer]
Unit=homelab-smart-state.service
# 08:30 daily, after firewall-claims. This half reads only local block devices
# — morpheus is homelab-smart-state-remote.timer at 08:45 — so it depends on
# nothing outside this machine and could run at any hour. It sits here to keep
# the two SMART jobs adjacent.
#
# Daily is generous for what it measures: a drive's endurance moves over months.
# The interval is set by the one signal that is not slow — SmartDriveUnhealthy is
# a latch the firmware sets once it has concluded the disk is failing, and
# waiting a week to notice that is not a trade worth making for a job that takes
# two seconds.
OnCalendar=*-*-* 08:30:00
RandomizedDelaySec=900
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
