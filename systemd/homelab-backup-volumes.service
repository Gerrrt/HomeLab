# Weekly quiesced backup of the observability stack's volumes.
#
# This unit is the fully-commented one of the five; the others state only what
# differs. Installed by scripts/install-timers.sh, which is also what asserts
# that every ExecStart= here goes through run-scheduled.sh (#77).
[Unit]
Description=HomeLab: quiesce the observability stack and archive its volumes
Documentation=file:///home/robo/code/Gerrrt/HomeLab/docs/runbooks/schedule-maintenance.md
# Wants= rather than Requires=: a docker.service that is merely slow should
# delay this run, not fail it. backup-volumes.sh does its own `docker info`
# preflight and dies with a readable message if the daemon is genuinely absent.
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
# oneshot, not simple: systemd then treats the unit as active until the process
# exits, so `systemctl list-timers` reports a truthful LAST/PASSED and a second
# trigger cannot start a second copy while the first is still running.
Type=oneshot
User=robo
Group=robo
# The Docker socket is srw-rw---- root:docker and robo's primary group is robo.
# A login shell picks the docker group up from /etc/group; a systemd unit does
# not. Without this the preflight `docker info` in backup-volumes.sh fails and
# the backup never runs — a failure that does not reproduce interactively.
SupplementaryGroups=docker
# Load-bearing, not tidiness. backup-firewall.sh resolves backups/firewall and
# .sops.yaml RELATIVE to the process's directory, so on that unit this line is
# the difference between a backup and a crash. Same directive everywhere so the
# five units cannot disagree about where the repository is.
WorkingDirectory=/home/robo/code/Gerrrt/HomeLab
Environment=STACK=observability
# Explicit even though User= already sets $HOME from the passwd entry: the
# scripts document this variable by name, and an explicit value is greppable.
Environment=SOPS_AGE_KEY_FILE=/home/robo/.config/sops/age/keys.txt
# KEEP=, STOP_TIMEOUT= and FW_HOST= are host facts, not repository facts. The
# leading - means an absent file is not an error.
EnvironmentFile=-/etc/default/homelab-timers
ExecStart=/home/robo/code/Gerrrt/HomeLab/scripts/run-scheduled.sh --job backup-volumes --lock backups --lock-wait 900 -- /usr/bin/make -C /home/robo/code/Gerrrt/HomeLab backup
# The stack is down for the duration, and the trap in backup-volumes.sh only
# restarts it on an EXIT PATH — a hang has no exit path and nothing recovers.
# This is the ceiling on that. The normal run is about ninety seconds.
TimeoutStartSec=1800
# Deliberately not Restart=on-failure. A retry stops the stack a second time,
# and the outcome is already a metric with an alert on it: the right response to
# a failed backup is a human reading the journal, not another outage.
Restart=no
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
# Hardening, and what is deliberately absent.
#
# ProtectSystem=strict, PrivateDevices and friends are NOT here. This process
# holds a handle on /var/run/docker.sock, and anything reachable through that
# API is reachable as root on this host regardless of the unit's namespace —
# compose.yaml says the same thing about Alloy. Sandboxing a process that can
# ask the daemon to mount / read-write is theatre.
#
# ProtectHome is stated rather than omitted because both the repository and the
# age key live under /home/robo: a future ProtectHome=read-only breaks render,
# and ProtectHome=yes breaks everything.
ProtectHome=false
ProtectSystem=false
# PrivateTmp is off on purpose. The Docker daemon resolves -v source paths in
# the HOST mount namespace, so a private /tmp would silently bind-mount the
# wrong directory into any container this job starts.
PrivateTmp=false
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
# stdout and stderr are the journal, which Alloy already ships to Loki with a
# `unit` label. No log file, so nothing to rotate and nothing to forget.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-backup-volumes

# No [Install] section, on purpose. The timer is what enables this. A oneshot
# .service carrying WantedBy=multi-user.target can be enabled by accident, and
# would then quiesce the monitoring stack at every boot.
