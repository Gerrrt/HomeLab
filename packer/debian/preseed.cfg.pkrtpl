# Rendered by packer/debian.pkr.hcl with templatefile() and served once over
# Packer's HTTP server. Debian trixie preseed for the dotfiles-Debian VM's
# template (#920, ADR-0090). Kali's (kali/preseed.cfg.pkrtpl) with Debian's
# mirror and suite, and without the Kali metapackage.
#
# The `packer` user lives for the length of the build: key-only, password
# disabled, deleted by the build's last provisioner. A clone's user comes from
# the Proxmox cloud-init drive.

d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select us
d-i time/zone string Etc/UTC
d-i clock-setup/utc boolean true
d-i clock-setup/ntp boolean true

d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string tpl-debian-13
d-i netcfg/get_domain string
d-i hw-detect/load_firmware boolean false

d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string
d-i mirror/suite string trixie
d-i mirror/codename string trixie

d-i passwd/root-login boolean false
d-i passwd/user-fullname string packer
d-i passwd/username string packer
d-i passwd/user-password-crypted password !
d-i user-setup/allow-password-weak boolean false

# #1128: the ESP, then / over the rest of the disk, and no swap partition.
# partman's `atomic` put swap after /, so a clone given a bigger disk than the
# template's could not grow / into it: cloud-init's growpart found swap in the
# way and changed nothing (garuda, 2026-10-10, 59.7 GB of 80). With / last,
# growpart reaches the end of whatever disk the clone has. A guest that wants
# swap gets a swapfile, as garuda's runbook does.
d-i partman-auto/method string regular
d-i partman-auto/expert_recipe string \
  esp-root :: \
    1024 1024 1024 free \
      $iflabel{ gpt } $reusemethod{ } \
      method{ efi } format{ } \
    . \
    4096 8192 -1 ext4 \
      $primary{ } $bootable{ } \
      method{ format } format{ } \
      use_filesystem{ } filesystem{ ext4 } \
      mountpoint{ / } \
    .
d-i partman-auto/choose_recipe select esp-root
d-i partman-basicfilesystems/no_swap boolean false
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

d-i apt-setup/use_mirror boolean true
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/services-select multiselect security, updates
tasksel tasksel/first multiselect standard, ssh-server
# curl and git because dotfiles-Debian's bootstrap needs the first and clones
# with the second; sudo because the clone's cloud-init user is given it.
d-i pkgsel/include string openssh-server sudo qemu-guest-agent cloud-init curl git
d-i pkgsel/upgrade select full-upgrade
popularity-contest popularity-contest/participate boolean false

d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string default
# Also to the removable path, EFI/BOOT/BOOTX64.EFI, so a clone whose EFI vars
# lost the installer's boot entry still finds the shim.
d-i grub-installer/force-efi-extra-removable boolean true

d-i preseed/late_command string \
  in-target mkdir -p /home/packer/.ssh; \
  echo '${ssh_public_key}' > /target/home/packer/.ssh/authorized_keys; \
  in-target chown -R packer:packer /home/packer/.ssh; \
  in-target chmod 700 /home/packer/.ssh; \
  in-target chmod 600 /home/packer/.ssh/authorized_keys; \
  echo 'packer ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/90-packer; \
  chmod 0440 /target/etc/sudoers.d/90-packer; \
  in-target systemctl enable ssh qemu-guest-agent

d-i finish-install/reboot_in_progress note
