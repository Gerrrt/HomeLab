<?xml version="1.0" encoding="utf-8"?>
<!--
  The answer file a CLONE reads, passed to sysprep /generalize /oobe /unattend:
  by scripts/sysprep.ps1. Uploaded by the build; never on the answer disc.

  ComputerName * gives each clone a random name, which is a placeholder: the
  real one (bahamut, carbuncle…) is set by ansible/'s base role (#448).
  The Administrator password is the build password until that role rotates
  it. It opens the console and nothing else: the clone's only remote way in is
  OpenSSH, key-only (scripts/openssh.ps1, ADR-0077).

  As in Autounattend.xml, LLMNR, NetBIOS, IPv6 and WPAD are left alone
  (ADR-0029).
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>*</ComputerName>
      <TimeZone>UTC</TimeZone>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <UserAccounts>
        <AdministratorPassword>
          <Value>${build_password}</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>
      </UserAccounts>
      <!--
        AutoLogon ONCE, then off (#1092). Without it a Windows 11 clone parks
        forever on the OOBE "create a user account" page: HideLocalAccountScreen
        with only the built-in Administrator does not finish that page on client
        SKUs, only on Server. The generalised image still never autologins -
        scripts/sysprep.ps1 strips the build's autologon, and this file re-adds
        it for the clone's single OOBE pass alone. LogonCount 1 spends it, and
        the FirstLogonCommand below turns it off, deletes the plaintext
        DefaultPassword that Setup writes to Winlogon and logs off, so nothing
        persists past that first logon. The built-in Administrator stays
        enabled with the build password (above) until ansible/'s base role
        rotates it (#448).
      -->
      <AutoLogon>
        <Enabled>true</Enabled>
        <LogonCount>1</LogonCount>
        <Username>Administrator</Username>
        <Password>
          <Value>${build_password}</Value>
          <PlainText>true</PlainText>
        </Password>
      </AutoLogon>
      <!--
        One command, not three. Windows 10 and 11 do not wait for one
        SynchronousCommand to finish before starting the next, so a separate
        logoff could end the session before the two reg commands ran, leaving
        the autologon on and the password in Winlogon. Chained in one cmd, the
        logoff can only come after both. & rather than &&: the session ends
        even if a reg command fails, since LogonCount 1 is already spent.
      -->
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Turn the one-shot autologon off, drop the plaintext credential Setup wrote to Winlogon, then log the session off so the clone rests at the sign-in screen</Description>
          <CommandLine>cmd /c "reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" /v AutoAdminLogon /t REG_SZ /d 0 /f &amp; reg delete "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" /v DefaultPassword /f &amp; shutdown /l /f"</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
