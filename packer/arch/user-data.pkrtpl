#cloud-config
# Rendered by packer/arch.pkr.hcl with templatefile(). Read by the Arch ISO's
# own cloud-init from the disc labelled `cidata` (NoCloud), in the LIVE
# system: it lets Packer in as root with phoenix's key, and nothing else.
# The installed system is written by arch/install.sh over that session.
#
# disable_root false, and the key given to root by name: with cloud-init's
# defaults the key goes to the ISO's default user, `arch`, and root's is
# wrapped in a command that prints "Please login as the user arch" and exits
# 142, which is how the first build hung (2026-10-09).
disable_root: false
users:
  - name: root
    ssh_authorized_keys:
      - ${ssh_public_key}
runcmd:
  - [systemctl, start, sshd, qemu-guest-agent]
