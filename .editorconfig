root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.alloy]
indent_style = tab

# caddy fmt writes tabs and check_caddyfile.sh fails a file it would reformat,
# so the two tools have to agree — the same treatment the Alloy formatter gets.
[Caddyfile]
indent_style = tab
